# このファイルを参考に、同じ場所に .env.local を作って値を入れます。
# 注意: NEXT_PUBLIC_ で始まる名前にするとブラウザに公開されます。
#       APIキーには NEXT_PUBLIC_ を付けず、サーバー側だけで使います。

# 為替データ（Twelve Data）
FX_DATA_API_KEY=

# Claude API（Claude Console で発行。claude.ai の有料プランとは別の、従量課金です）
ANTHROPIC_API_KEY=

# 任意：使うモデル（省略時は claude-haiku-5-5。より賢く高価なのは claude-sonnet-5-5）
# CLAUDE_MODEL=claude-haiku-5-5

# 任意：1日に Claude で分析する回数の上限（省略時は 200）
# CLAUDE_DAILY_LIMIT=200

# ---- 株スイング ----
# J-Quants（JPX公式）。ダッシュボードの「APIキー」画面で発行
JQUANTS_API_KEY=
# プラン：free / light / standard / premium（回数制限の間隔に使う。省略時は free＝1分5回）
JQUANTS_PLAN=free

# Supabase（省略すると、このPCの .data フォルダに保存。Vercel では必須）
# Project Settings → API の Project URL と service_role キー。service_role は絶対にブラウザ側へ出さない
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 任意：開示スコアの1日の上限回数（省略時は 500）
# CLAUDE_SCORE_DAILY_LIMIT=500
